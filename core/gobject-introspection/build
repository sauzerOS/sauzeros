#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

MESON_OPTS=(
    --prefix="$PREFIX"
    --buildtype=release
)

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    MESON_OPTS+=(--cross-file "$HOKUTO_ARCH")

    # Use hokuto's native pkg-config wrapper so the target sysroot it exports
    # globally isn't applied to native (build-machine) dependency lookups.
    if [ -n "$HOKUTO_NATIVE_FILE" ]; then
        MESON_OPTS+=(--native-file "$HOKUTO_NATIVE_FILE")
    fi
fi

meson setup build "${MESON_OPTS[@]}"
meson compile -C build
meson install -C build --destdir=$1


