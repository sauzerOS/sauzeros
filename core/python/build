#!/bin/bash -e

# Reported 20-27% performance improvements.
# See: "PythonNoSemanticInterpositionSpeedup"
export CFLAGS="$CFLAGS -fno-semantic-interposition -ffat-lto-objects"
export LDFLAGS="$LDFLAGS -fno-semantic-interposition"

# Use CROSS_PREFIX if set (defaults to /usr in hokuto)
PREFIX="${CROSS_PREFIX:-/usr}"

# Determine build strategy
if [[ "${HOKUTO_CROSS:-0}" == "1" ]]; then
    # HOKUTO_ARCH is already normalized to e.g. aarch64/x86_64
    HOST_TRIPLET="${HOKUTO_ARCH}-linux-gnu"
    CROSS_OPTS="--host=$HOST_TRIPLET --build=$(gcc -dumpmachine) --with-build-python"

    # Disable PGO/LTO optimizations during cross-compile as they require running target code
    # We also disable IPv6 because getaddrinfo detection usually fails during cross-compilation
    CROSS_OPTS="$CROSS_OPTS --disable-ipv6"

    # Ensure ncursesw headers are found (specifically term.h which is often not included by curses.h)
    export CFLAGS="$CFLAGS -I/usr/${HOST_TRIPLET}/usr/include/ncursesw"
    export CPPFLAGS="$CPPFLAGS -I/usr/${HOST_TRIPLET}/usr/include/ncursesw"

    # Pre-seed some results that cannot be determined when cross-compiling
    export ac_cv_file__dev_ptmx=yes
    export ac_cv_file__dev_ptc=no
else
    CROSS_OPTS="--enable-optimizations --with-lto"
fi

# use system expat
rm -r Modules/expat

./configure \
    --prefix="$PREFIX" \
    --enable-shared \
    $CROSS_OPTS \
    $OPTS \
    --with-system-expat

make EXTRA_CFLAGS="$CFLAGS -DTHREAD_STACK_SIZE=0x100000"

# ENSUREPIP=no: the built ./python resolves its prefix to the host's /usr, so
# ensurepip sees the host's installed pip and tries to upgrade/uninstall it
# (EACCES on /usr/bin/pip). pip is installed explicitly below instead.
make DESTDIR="$1" ENSUREPIP=no install

# Install the bundled pip wheel ignoring whatever is installed on the host,
# using the staged python (native) or the host python of the same version (cross).
site=$(echo "$1$PREFIX"/lib/python3.*/site-packages)
if [[ "${HOKUTO_CROSS:-0}" == "1" ]]; then
    build_python=(python3 -I)
else
    build_python=(env LD_LIBRARY_PATH="$1$PREFIX/lib" "$1$PREFIX/bin/python3" -I)
fi
pip_wheel=$(echo Lib/ensurepip/_bundled/pip-*.whl)
"${build_python[@]}" "$pip_wheel/pip" install --no-index --no-deps \
    --ignore-installed --no-compile --no-warn-script-location \
    --root "$1" --prefix "$PREFIX" "$pip_wheel"
"${build_python[@]}" -m compileall -q -f -s "$1" -p / "$site/pip"

ln -sf python3 "$1$PREFIX/bin/python"
if [[ -f "$1$PREFIX/bin/pip3" ]]; then
    ln -sf pip3 "$1$PREFIX/bin/pip"
fi

# Fix shebang in pip scripts (which capture the staging directory path)
# We want them to point to the actual install location (e.g. /usr/bin/python3)
for pip_bin in "$1$PREFIX/bin/pip"*; do
    if [[ -f "$pip_bin" ]]; then
        sed -i "1s|^#!.*python.*|#!$PREFIX/bin/python3|" "$pip_bin"
    fi
done

# remove tests
rm -rf "$1$PREFIX"/lib/python*/{test,idlelib/idle_test}