#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

CROSS_OPTS=""
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    HOST_TRIPLET="${HOKUTO_ARCH}-linux-gnu"
    [ "$HOKUTO_ARCH" = "x86_64" ] && HOST_TRIPLET="x86_64-linux-gnu"
    [ "$HOKUTO_ARCH" = "aarch64" ] && HOST_TRIPLET="aarch64-linux-gnu"
    CROSS_OPTS="--host=$HOST_TRIPLET"

    # flex normally regenerates its scanner by building "stage1flex" and
    # running it. src/Makefile.am only switches that to CC_FOR_BUILD when
    # autoconf sets cross_compiling=yes, and it does not here: the qemu-user
    # binfmt handler runs the target test binary, so configure decides it is
    # not cross compiling and stage1flex gets built with the cross compiler
    # and then executed. Upstream offers --disable-bootstrap for exactly this
    # case; it derives the scanner from the pre-generated scan.c that ships in
    # the tarball instead, with no target binary involved.
    CROSS_OPTS="$CROSS_OPTS --disable-bootstrap"
fi

./configure \
    --prefix="$PREFIX" \
    ac_cv_func_malloc_0_nonnull=yes \
    ac_cv_func_realloc_0_nonnull=yes \
    $CROSS_OPTS

make
make DESTDIR=$1 install

ln -s flex "$1$PREFIX/bin/lex"
