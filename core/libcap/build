#!/bin/bash -e

# Use CROSS_PREFIX if set (defaults to /usr in hokuto)
PREFIX="${CROSS_PREFIX:-/usr}"
SBINDIR="${PREFIX}/bin"
LIBDIR="${PREFIX}/lib"
PKGCONFIGDIR="${LIBDIR}/pkgconfig"
# Make.Rules spells its prefix variable in lowercase, so the PREFIX below never
# reaches it and the include/man paths keep their /usr defaults -- a cross
# build then drops sys/capability.h and the manpages into the *host* /usr and
# writes includedir=/usr/include into libcap.pc, which puts host headers on
# every cross compile line that uses it. Both default to /usr natively.
INC_PREFIX="${PREFIX}"
MAN_PREFIX="${PREFIX}/share"

# libcap Makefile doesn't strictly follow standard env vars, so we pass them explicitly
EXTRA_OPTS=""
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    EXTRA_OPTS="CC=${CC:-cc} AR=${AR:-ar} RANLIB=${RANLIB:-ranlib} OBJCOPY=${OBJCOPY:-objcopy} STRIP=${STRIP:-strip} PKG_CONFIG=${PKG_CONFIG:-pkg-config}"
fi

sed -i '/install -m.*STA/d' libcap/Makefile

mk() {
    make \
        GOLANG=no \
        PREFIX="$PREFIX" \
        SBINDIR="$SBINDIR" \
        LIBDIR="$LIBDIR" \
        inc_prefix="$INC_PREFIX" \
        man_prefix="$MAN_PREFIX" \
        PKGCONFIGDIR="$PKGCONFIGDIR" \
        RAISE_SETFCAP=no \
        INDENT=" " \
        $EXTRA_OPTS \
        "$@"
}

mk
mk DESTDIR="$1" install

# Make.Rules writes prefix= into the .pc from its own lowercase variable, which
# the uppercase PREFIX above never reaches, so a cross build ships .pc files
# claiming the host's /usr. libdir and includedir are pinned explicitly so the
# emitted flags are right either way, but anything reading the prefix variable
# -- pkg-config --variable=prefix, or a consumer deriving its own paths from it
# -- would be handed a host path.
sed -e "s|^prefix=.*|prefix=$PREFIX|" -i "$1$PKGCONFIGDIR"/lib{cap,psx}.pc

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32bit split package
make distclean
make CC="gcc -m32 -march=i686" GOLANG=no
make CC="gcc -m32 -march=i686" GOLANG=no lib=lib32 prefix=$PWD/DESTDIR/usr -C libcap install
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32/pkgconfig
cp -Rv DESTDIR/usr/lib32/* $dest_dir/usr/lib32
sed -e "s|^libdir=.*|libdir=/usr/lib32|" -i $dest_dir/usr/lib32/pkgconfig/lib{cap,psx}.pc
chmod -v 755 $dest_dir/usr/lib32/libcap.so.$2
fi
