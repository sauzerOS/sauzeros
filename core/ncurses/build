#!/bin/bash -e

# Use CROSS_PREFIX if set (defaults to /usr in hokuto)
PREFIX="${CROSS_PREFIX:-/usr}"

# configure copies the build's LDFLAGS into the Libs: of the .pc files, and
# every package linking ncurses through pkg-config took them over: hokuto's
# -fuse-ld=bfd -flto -O1 made util-linux link with ld.bfd, which then
# resolved libcryptsetup's libblkid to its own unversioned build tree copy.
# Keep the library and library path flags only.
clean_pc_libs() {
    local pc
    for pc in "$1"/*.pc; do
        [ -f "$pc" ] && [ ! -L "$pc" ] || continue
        awk '/^Libs:/ { line = "Libs:"; for (i = 2; i <= NF; i++) if ($i ~ /^-[lL]/ || $i ~ /^\$\{/) line = line " " $i; print line; next } { print }' "$pc" > "$pc.tmp"
        mv "$pc.tmp" "$pc"
    done
}

# triplet for --host
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    HOST_TRIPLET="${HOKUTO_ARCH}-linux-gnu"
    [ "$HOKUTO_ARCH" = "x86_64" ] && HOST_TRIPLET="x86_64-linux-gnu"
    [ "$HOKUTO_ARCH" = "aarch64" ] && HOST_TRIPLET="aarch64-linux-gnu"
    CROSS_OPTS="--host=$HOST_TRIPLET"
fi

# ncurses picks the header location from the prefix:
#   if test "$prefix" = "/usr" ; then with_overwrite=yes; else with_overwrite=no; fi
# So a native or plain-cross build (prefix /usr) installs curses.h, term.h and
# friends straight into include/, while a cross-system build (prefix
# /usr/<triplet>) buries them in include/ncursesw/. That asymmetry breaks any
# cross build whose source does a bare #include <curses.h> -- psmisc's pstree.c
# does, and it fails at compile time because its configure only probes for the
# library, never the header. Ask for the same layout everywhere.
./configure \
    --prefix="$PREFIX" \
    --mandir="$PREFIX/share/man" \
    --enable-overwrite \
    --enable-pc-files \
    --disable-rpath-hack \
    --with-pkg-config-libdir="$PREFIX/lib/pkgconfig" \
    --with-shared \
    --enable-widec \
    --without-ada \
    --without-tests \
    --without-debug \
    --without-cxx-binding \
    --disable-stripping \
    $CROSS_OPTS

make
make DESTDIR=$1 install
clean_pc_libs "$1$PREFIX/lib/pkgconfig"

# Force ncurses to link against wide-character ncurses library.
for lib in ncurses form panel menu; do
    rm -f "$1$PREFIX/lib/lib${lib}.so"
    printf '%s\n' "INPUT(-l${lib}w)" > "$1$PREFIX/lib/lib${lib}.so"
    chmod 755 "$1$PREFIX/lib/lib${lib}.so"
    ln -sf "lib${lib}w.a" "$1$PREFIX/lib/lib${lib}.a"
done

# Some packages look for libcurses instead of libncurses when building.
printf '%s\n' "INPUT(-lncursesw)" > "$1$PREFIX/lib/libcursesw.so"
ln -sf libncurses.so "$1$PREFIX/lib/libcurses.so"

# Fix pkgconfig file.
ln -sf ncursesw.pc "$1$PREFIX/lib/pkgconfig/ncurses.pc"

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32bit split package
make distclean
CC="gcc -m32" CXX="g++ -m32" \
./configure --prefix=/usr           \
            --host=i686-pc-linux-gnu \
            --libdir=/usr/lib32     \
            --mandir=/usr/share/man \
            --with-shared           \
            --without-debug         \
            --without-normal        \
            --with-cxx-shared       \
            --enable-pc-files       \
            --with-pkg-config-libdir=/usr/lib32/pkgconfig

make
make DESTDIR=$PWD/DESTDIR install
clean_pc_libs DESTDIR/usr/lib32/pkgconfig
mkdir -p DESTDIR/usr/lib32/pkgconfig
for lib in ncurses form panel menu ; do
    rm -vf                    DESTDIR/usr/lib32/lib${lib}.so
    echo "INPUT(-l${lib}w)" > DESTDIR/usr/lib32/lib${lib}.so
    ln -svf ${lib}w.pc        DESTDIR/usr/lib32/pkgconfig/$lib.pc
done
rm -vf                     DESTDIR/usr/lib32/libcursesw.so
echo "INPUT(-lncursesw)" > DESTDIR/usr/lib32/libcursesw.so
ln -sfv libncurses.so      DESTDIR/usr/lib32/libcurses.so
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
