#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"
export PKG_CONFIG_SYSTEMDUSERUNITDIR="${PREFIX}/lib/systemd/user"
meson_options=(
      --prefix="$PREFIX"  \
      --buildtype=release \
      -D trust_paths=/etc/pki/anchors \
)

hokuto-meson p11-build "${meson_options[@]}"
meson compile -C p11-build
meson install -C p11-build --destdir=$1

# Fix incorrect paths from cross-compilation
if [ "${HOKUTO_CROSS:-0}" = "1" ] && [ "$PREFIX" = "/usr" ]; then
    if [ -d "$1$PREFIX/$HOKUTO_ARCH-linux-gnu" ]; then
        echo "Moving files from sysroot $1$PREFIX/$HOKUTO_ARCH-linux-gnu to $1$PREFIX"
        cp -rl "$1$PREFIX/$HOKUTO_ARCH-linux-gnu/"* "$1$PREFIX/"
        rm -rf "$1$PREFIX/$HOKUTO_ARCH-linux-gnu"
    fi
fi

ln -sfv "$PREFIX/lib/p11-kit/trust-extract-compat" \
        "$1$PREFIX/bin/update-ca-certificates"
ln -sfv ./pkcs11/p11-kit-trust.so "$1$PREFIX/lib/libnssckbi.so"

if [ "$MULTILIB" = "1" ]; then
#32 bit split package
rm -rf p11-build
meson setup p11-build                       \
            --prefix=/usr                   \
            --buildtype=release             \
            --cross-file=lib32              \
            --libdir=/usr/lib32             \
            -D test=false                   \
            -D trust_paths=/etc/pki/anchors

meson compile -C p11-build
meson install -C p11-build --destdir=$PWD/DESTDIR
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d "$dest_dir/usr/lib32"
cp -vr DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
