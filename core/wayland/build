#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

MESON_OPTS=(
    -D default_library=both
    -D tests=false
    -D documentation=false
    -D dtd_validation=false
)

# hokuto-meson adds the prefix, the cross file and hokuto's native pkg-config
# file for cross builds. The scanner runs during the build, so a cross build
# must use the host's copy rather than building or finding a target one.
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    cat <<EOF > host-tools.ini
[binaries]
wayland-scanner = '/usr/bin/wayland-scanner'
EOF
    MESON_OPTS+=(--native-file host-tools.ini)
fi

hokuto-meson build "${MESON_OPTS[@]}"
meson compile -C build
meson install -C build --destdir=$1

# During cross-compilation, provide a symlink to the host wayland-scanner in the sysroot.
# This ensures that tools (like wayland-protocols) find and can execute the host scanner.
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    mkdir -p "$1/$PREFIX/bin"
    ln -sf /usr/bin/wayland-scanner "$1/$PREFIX/bin/wayland-scanner"
fi

if [ "$MULTILIB" = "1" ]; then
#32bit split package
rm -rf build
hokuto-meson-32 build \
  -D tests=false \
  -D documentation=false \
  -D dtd_validation=false

meson compile -C build
meson install -C build --destdir=$PWD/DESTDIR
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
