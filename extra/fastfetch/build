#!/bin/bash -e

PREFIX=${CROSS_PREFIX:-/usr}

patch -Np1 -i sauzeros-logo.patch

CMAKE_FLAGS=()

if [ "$HOKUTO_CROSS" = "1" ]; then
    CROSS_SYSROOT="$(${CC:-${HOKUTO_ARCH}-linux-gnu-gcc} -print-sysroot 2>/dev/null)"
    [ -n "$CROSS_SYSROOT" ] || CROSS_SYSROOT="/usr/${HOKUTO_ARCH}-linux-gnu"

    CMAKE_FLAGS+=(
        -D CMAKE_SYSTEM_NAME=Linux
        -D CMAKE_SYSTEM_PROCESSOR="$HOKUTO_ARCH"

        # Scope find_package/find_path/find_library to the cross sysroot.
        # Without this CMake resolves host dependencies (lua, sqlite3, ...) and
        # puts -I/usr/include on the command line. The aarch64 compiler then
        # reads x86_64 glibc headers, whose bits/wordsize.h keys off
        # __x86_64__ and therefore reports __WORDSIZE=32; that miscomputes
        # SIZE_MAX and breaks the build in confusing ways, e.g. the D3DKMT
        # static_asserts in gpu_windows.c (compiled on Linux for WSL).
        -D CMAKE_SYSROOT="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH="$CROSS_SYSROOT"
        # Build tools still have to come from the host.
        -D CMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
        -D CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY

        -D ENABLE_CHAFA=OFF
        -D ENABLE_VULKAN=OFF
        -D ENABLE_DRM=OFF
        -D ENABLE_DRM_AMDGPU=OFF
        -D ENABLE_XRANDR=OFF
        -D ENABLE_PULSE=OFF
        -D ENABLE_EGL=OFF
        -D ENABLE_GLX=OFF
        -D ENABLE_RPM=OFF
    )
fi

cmake -B build -D CMAKE_INSTALL_PREFIX="$PREFIX" "${CMAKE_FLAGS[@]}"
cmake --build build --target fastfetch --target flashfetch
DESTDIR=$1 cmake --install build

install -Dm644 hokuto.png $1/usr/share/pixmaps/hokuto.png
install -Dm644 config.jsonc $1/etc/fastfetch/config.jsonc
