#!/bin/bash -e

# gobject-introspection runs the just-built library to scan it, which cannot
# work when that library is for another architecture.
cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    cross_opts=(-D introspection=disabled -D tests=false)
fi

hokuto-meson build           \
    -D gtk_doc=false         \
    -D docbook_docs=disabled \
    -D man=false "${cross_opts[@]}"

meson compile -C build
meson install -C build --destdir=$1
