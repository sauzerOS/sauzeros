#!/bin/bash -e

# A cross build installs into the target sysroot, never the host's /usr, and
# configure needs --host so it stops probing the build machine. qemu binfmt is
# registered here, so gnulib's run tests would otherwise execute target
# binaries and conclude the build is native; --host alone is not enough, hence
# the explicit --build.
PREFIX="${CROSS_PREFIX:-/usr}"

CROSS_OPTS=""
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_OPTS="--host=${HOKUTO_ARCH}-linux-gnu --build=$(gcc -dumpmachine)"
fi

./configure                   \
    --prefix="$PREFIX"        \
    --with-included-unistring \
    --disable-doc             \
    --enable-static           \
    $CROSS_OPTS

make
make DESTDIR="$1" install

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32 bit split package
make distclean
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure                  \
    --prefix=/usr            \
    --libdir=/usr/lib32      \
    --libexecdir=/usr/lib32  \
    --without-p11-kit        \
    --disable-static         \
    --disable-doc            \
    --with-included-unistring \
    --host=i686-pc-linux-gnu \
    --build=i686-pc-linux-gnu

make
make DESTDIR=$PWD/DESTDIR install
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
