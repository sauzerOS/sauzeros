#!/bin/bash
set -e

sed 's|.install-cython ||' -i Makefile

# Cython 3.3.0 crashes compiling the WebSocket reader on an annotated
# module constant that reader_c.pxd declares as cdef (same bug as
# aiohttp #13520, whose fix for the other constants is in 3.14.4)
sed 's/^MSG_SIZE_OVERHEAD: Final\[int\] = /MSG_SIZE_OVERHEAD = /' \
    -i aiohttp/_websocket/reader_py.py

export AIOHTTP_USE_SYSTEM_DEPS=1
make cythonize
python -m build --wheel --no-isolation
python -m installer --destdir="$1" dist/*.whl
