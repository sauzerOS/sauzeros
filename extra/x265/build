#!/bin/bash -e

# A cross build installs into the target sysroot, never the host's /usr.
# CMAKE_INSTALL_LIBDIR must stay relative so CMake joins it with the prefix;
# an absolute value is taken verbatim and escapes the sysroot.

#32 bit fix
sed -i 's/FORMAT_ELF/UNIX64 && FORMAT_ELF/' source/common/x86/cpu-a.asm

cmake -B build \
      -D CMAKE_INSTALL_PREFIX="${CROSS_PREFIX:-/usr}" \
      -D CMAKE_INSTALL_LIBDIR=lib        \
      -D GIT_ARCHETYPE=1                  \
      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -W no-dev source

cmake --build build
DESTDIR=$1 cmake --install build
rm -vf $1/usr/lib/libx265.a

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32bit split package
rm -rf build
CC="gcc -m32" CXX="g++ -m32"              \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig      \
cmake -B build \
      -D CMAKE_INSTALL_PREFIX=/usr        \
      -D LIB_INSTALL_DIR=lib32            \
      -D GIT_ARCHETYPE=1                  \
      -D CMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -W no-dev source

cmake --build build
DESTDIR=$PWD/DESTDIR cmake --install build
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -vR DESTDIR/usr/lib32/* $dest_dir/usr/lib32
rm -vf $dest_dir/usr/lib32/libx265.a
fi
