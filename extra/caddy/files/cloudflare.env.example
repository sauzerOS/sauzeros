# Cloudflare API token used for the ACME DNS-01 challenge.
#
# Copy this file to /etc/caddy/cloudflare.env and drop in a real token:
#
#     install -m 600 -o root -g root cloudflare.env.example /etc/caddy/cloudflare.env
#     # edit it, then:
#     systemctl restart caddy
#
# The token needs exactly one permission: Zone -> DNS -> Edit, on the zone
# caddy manages certificates for. Create it at
# https://dash.cloudflare.com/profile/api-tokens
#
# systemd reads this file as root before dropping to the caddy user, so keep
# it 0600 root:root -- the caddy user never needs to read it.
#
# Finally, uncomment the acme_dns line in /etc/caddy/Caddyfile.

CLOUDFLARE_API_TOKEN=
