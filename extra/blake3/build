#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

TARGET_ARCH="$HOKUTO_ARCH"
[ "$TARGET_ARCH" = "arm64" ] && TARGET_ARCH="aarch64"
[ "$TARGET_ARCH" = "amd64" ] && TARGET_ARCH="x86_64"

# Determine target triplet for cross-compilation
TARGET_TRIPLET=""
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    TARGET_TRIPLET="${TARGET_ARCH}-unknown-linux-gnu"
else
    TARGET_TRIPLET="$(rustc -vV | sed -n 's/host: //p')"
fi

cd b3sum
cargo fetch --locked --target "$TARGET_TRIPLET"
cargo build --release --target "$TARGET_TRIPLET"
install -Dt "$1$PREFIX"/bin target/$TARGET_TRIPLET/release/b3sum

# libblake3 split package
cd ../c
destdir=$HOKUTO_SPLIT_DIR/libblake3
cmake_options=(
    -B build
    -W no-author
    -D CMAKE_BUILD_TYPE=None
    -D CMAKE_INSTALL_PREFIX="$PREFIX"
    # GNUInstallDirs picks lib64 on x86_64, so the native package landed in
    # /usr/lib64 while every other library here uses /usr/lib -- and the cross
    # build, where CMAKE_SYSTEM_PROCESSOR is aarch64, already chose lib. Pin it
    # so both variants agree.
    -D CMAKE_INSTALL_LIBDIR=lib
    -D BUILD_SHARED_LIBS=ON
)

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_SYSROOT="$(${CC:-${TARGET_ARCH}-linux-gnu-gcc} -print-sysroot 2>/dev/null)"
    [ -n "$CROSS_SYSROOT" ] || CROSS_SYSROOT="/usr/${TARGET_ARCH}-linux-gnu"

    # c/CMakeLists.txt selects its SIMD backend purely from
    # CMAKE_SYSTEM_PROCESSOR. Left unset it reads the build host's x86_64,
    # picks "amd64-asm" and hands blake3_avx512_x86-64_unix.S to the aarch64
    # assembler ("unknown mnemonic `vpshufd'"). With it set, aarch64 matches
    # BLAKE3_ARMv8_NAMES and the NEON intrinsics are built instead.
    cmake_options+=(
        -D CMAKE_SYSTEM_NAME=Linux
        -D CMAKE_SYSTEM_PROCESSOR="$TARGET_ARCH"
        -D CMAKE_SYSROOT="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
        -D CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
    )
fi

cmake "${cmake_options[@]}"
cmake --build build
DESTDIR="$destdir" cmake --install build
