#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

zcat libpng-1.6.55-apng.patch.gz | patch -Np1

CMAKE_FLAGS=()

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_SYSROOT="$(${CC:-${HOKUTO_ARCH}-linux-gnu-gcc} -print-sysroot 2>/dev/null)"
    [ -n "$CROSS_SYSROOT" ] || CROSS_SYSROOT="/usr/${HOKUTO_ARCH}-linux-gnu"

    CMAKE_FLAGS+=(
        -D CMAKE_SYSTEM_NAME=Linux
        -D CMAKE_SYSTEM_PROCESSOR="$HOKUTO_ARCH"

        # Scope find_package/find_path/find_library to the cross sysroot, so
        # zlib resolves against the target and not the host. Host headers on
        # the include path would be read by the cross compiler, and glibc's
        # bits/wordsize.h keys off __x86_64__, so it would report
        # __WORDSIZE=32 and miscompile in confusing ways.
        -D CMAKE_SYSROOT="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH="$CROSS_SYSROOT"
        # Build tools still have to come from the host.
        -D CMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
        -D CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
    )
fi

cmake -B build                       \
  -D CMAKE_BUILD_TYPE=Release        \
  -D CMAKE_INSTALL_PREFIX="$PREFIX"  \
  -D BUILD_SHARED_LIBS=ON            \
  -D PNG_TESTS=OFF                   \
  -D PNG_STATIC=OFF                  \
  -D PNG_SHARED=ON                   \
  -D PNG_TOOLS=OFF                   \
  "${CMAKE_FLAGS[@]}"

cmake --build build
DESTDIR=$1 cmake --install build

if [ "$MULTILIB" = "1" ]; then
#32bit split package
rm -rf build
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu \
            --disable-static

make
make DESTDIR=$PWD/DESTDIR install
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -vr DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
