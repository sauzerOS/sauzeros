#!/bin/bash -e

# The VideoCore GPU, not the ARM core, is what boots a Raspberry Pi: it reads
# bootcode.bin (Pi 0-3; on Pi 4 this lives in on-board EEPROM instead), then
# start*.elf plus the matching fixup*.dat, and only then hands off to the ARM
# kernel. The firmware reads these from the first FAT partition, so they must
# land in /boot.
#
#   start4*.elf / fixup4*.dat   BCM2711  (Pi 4, Pi 400, CM4)
#   start*.elf  / fixup*.dat    BCM2835/6/7 (Pi 0-3)
#
# The plain, cd, db and x variants trade GPU features against memory: cd is the
# cut-down build, x the extended one, db the debug one.

install -d "$1/boot"
install -m 644 bootcode.bin -t "$1/boot"
install -m 644 start.elf start4.elf start4cd.elf start4db.elf start4x.elf \
               start_cd.elf start_db.elf start_x.elf -t "$1/boot"
install -m 644 fixup.dat fixup4.dat fixup4cd.dat fixup4db.dat fixup4x.dat \
               fixup_cd.dat fixup_db.dat fixup_x.dat -t "$1/boot"

install -Dm 644 LICENCE.broadcom \
    "$1/usr/share/licenses/raspberrypi-firmware/LICENCE.broadcom"

# Bluetooth firmware for the on-board radio. Unlike the boot files above these
# are read by the kernel at runtime, not by the VideoCore at boot, so they go
# to /usr/lib/firmware rather than /boot. Shipping every Pi model's blob keeps
# one image usable across boards; together they are well under a megabyte.
install -d "$1/usr/lib/firmware/brcm"
for _f in BCM4345C0 BCM4345C5 BCM43430A1 BCM43430B0 BCM4343A2; do
    install -m 644 "$_f.hcd" "$1/usr/lib/firmware/brcm/$_f.hcd"
done
# WiFi firmware for the same radio. The BCM43455 covers every bcm2711 board
# (Pi 4 B, Pi 400, CM4), which is all this distro's kernel builds for, so the
# one chip is enough here. Without these the driver finds nothing and no wlan
# interface is created at all:
#     brcmfmac: Direct firmware load for brcm/brcmfmac43455-sdio.bin failed
# The driver asks for the board-specific name first and falls back to the plain
# one, which is what upstream's per-board files are symlinks to anyway.
# cyfmac43455-sdio-standard.bin is the default variant; the -minimal one exists
# only to raise the AP-mode client limit and drops 802.11k/v/r roaming with it.
install -m 644 brcmfmac43455-sdio.bin "$1/usr/lib/firmware/brcm/brcmfmac43455-sdio.bin"
install -m 644 brcmfmac43455-sdio.clm_blob "$1/usr/lib/firmware/brcm/brcmfmac43455-sdio.clm_blob"
install -m 644 brcmfmac43455-sdio.txt "$1/usr/lib/firmware/brcm/brcmfmac43455-sdio.txt"

install -Dm 644 LICENSE.cypress \
    "$1/usr/share/licenses/raspberrypi-firmware/LICENSE.cypress"

