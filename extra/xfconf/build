#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"
CROSS_OPTS=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_OPTS+=(--host="$HOKUTO_ARCH-linux-gnu")
fi
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # gobject-introspection scans the just-built library, and the sysroot's
    # GLib has no .gir; the vala bindings are generated from the .gir.
    CROSS_OPTS+=(--disable-introspection --disable-vala)
fi

./configure \
    --prefix="$PREFIX" \
    --localstatedir=/var \
    --sysconfdir=/etc \
    --mandir="$PREFIX/share/man" \
    "${CROSS_OPTS[@]}"

make
make DESTDIR="$1" install
