#!/bin/bash -e

# TEMP WORKAROUND: system ICU 79 crashes gen-regexp-special-case
# (Check failed: ch <= 0xffff). Using bundled small-icu until Node supports ICU 79.
# When this fails: check whether the new Node release builds with system-icu,
# then delete this block and restore --with-intl=system-icu.
ICU_WORKAROUND_NODE_VERSION="26.12.1"   # the exact version you're building now

if [ "$2" != "$ICU_WORKAROUND_NODE_VERSION" ]; then
    echo "ERROR: Node is now $version (workaround was for $ICU_WORKAROUND_NODE_VERSION)." >&2
    echo "Re-test --with-intl=system-icu, then remove the ICU workaround." >&2
    exit 1
fi

# Node.js configure expects specific names for CPUs
# mapping: aarch64 -> arm64, x86_64 -> x64
DEST_CPU="$HOKUTO_CARCH"
if [ -z "$DEST_CPU" ]; then
    DEST_CPU=$(uname -m)
fi

case "$DEST_CPU" in
    x86_64)  DEST_CPU="x64" ;;
    aarch64) DEST_CPU="arm64" ;;
esac

# Common configure arguments
CONF_ARGS="--prefix=$CROSS_PREFIX \
           --shared-libuv   \
           --shared-nghttp2 \
           --shared-zlib    \
           --shared-openssl \
           --shared-brotli  \
           --shared-cares   \
           --shared-zstd    \
           --shared-ffi     \
           --with-intl=small-icu \
           --experimental-enable-pointer-compression"

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    ./configure $CONF_ARGS \
        --dest-cpu="$DEST_CPU" \
        --dest-os=linux \
        --cross-compiling
else
    # Regular native build
    ./configure $CONF_ARGS
fi

make
make install DESTDIR="$1"

# npm split package
_pick "$1" npm usr/bin/npm
_pick "$1" npm usr/bin/npx
_pick "$1" npm usr/lib/node_modules/npm/
_pick "$1" npm usr/share/bash-completion/completions/npm
