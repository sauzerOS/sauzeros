#!/bin/bash -e

# Node.js configure expects specific names for CPUs
# mapping: aarch64 -> arm64, x86_64 -> x64
DEST_CPU="$HOKUTO_CARCH"
if [ -z "$DEST_CPU" ]; then
    DEST_CPU=$(uname -m)
fi

case "$DEST_CPU" in
    x86_64)  DEST_CPU="x64" ;;
    aarch64) DEST_CPU="arm64" ;;
esac

# Common configure arguments
CONF_ARGS="--prefix=$CROSS_PREFIX \
           --shared-libuv   \
           --shared-nghttp2 \
           --shared-zlib    \
           --shared-openssl \
           --shared-brotli  \
           --shared-cares   \
           --shared-zstd    \
           --shared-ffi     \
           --with-intl=system-icu \
           --experimental-enable-pointer-compression"

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    ./configure $CONF_ARGS \
        --dest-cpu="$DEST_CPU" \
        --dest-os=linux \
        --cross-compiling
else
    # Regular native build
    ./configure $CONF_ARGS
fi

make
# Debug built files location
find out -name node -type f

make install DESTDIR="$1"

# npm split package
_pick "$1" npm usr/bin/npm
_pick "$1" npm usr/bin/npx
_pick "$1" npm usr/lib/node_modules/npm/
_pick "$1" npm usr/share/bash-completion/completions/npm
