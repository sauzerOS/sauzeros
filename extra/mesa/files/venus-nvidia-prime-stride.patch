    physical_dev->wsi_device.supports_scanout = false;
+   /* The host imports the prime blit buffers with EGL, and NVIDIA's ignores
+    * the given pitch of a linear dma-buf, assuming a 32-byte aligned one:
+    * with the default 256, every window not 64 pixels wide is skewed or
+    * black. Align as it assumes.
+    */
+   if (physical_dev->renderer_driver_id == VK_DRIVER_ID_NVIDIA_PROPRIETARY)
+      physical_dev->wsi_device.prime_linear_stride_align = 32;
