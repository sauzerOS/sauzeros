#!/bin/bash -e

# Ensure the window is within the screen even if positioned
# https://github.com/bbidulock/icewm/pull/809
# https://bbs.archlinux.org/viewtopic.php?id=309422
patch -Np1 -i static-position.patch

PREFIX="${CROSS_PREFIX:-/usr}"

CMAKE_OPTS=(
	-D CMAKE_BUILD_TYPE='None'
	-D CMAKE_INSTALL_PREFIX="$PREFIX"
	-W no-dev
)

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
	CMAKE_OPTS+=(
	)
	# Upstream's default image loader (imlib2) is kept: icecursor includes a
	# hard #error unless Imlib2 or GdkPixbuf is present, so the libpng/XPM
	# loader alone does not build the full package.
	# icesound is the only consumer of alsa-lib and libsndfile, neither of which
	# is cross built. ICESOUND cannot simply be emptied: upstream does
	# string(TOLOWER ${ICESOUND} ICESOUND), which with an empty value collapses
	# to a one-argument call and fails configuration outright. OSS is the one
	# backend that needs no library at all -- it just opens /dev/dsp.
	CMAKE_OPTS+=(-D ICESOUND=OSS)
fi

cmake -B build "${CMAKE_OPTS[@]}"

cmake --build build
DESTDIR="${1}" cmake --install build

# Upstream generates $LIBDIR/preferences by running the freshly built genpref,
# inside an `if(NOT CMAKE_CROSSCOMPILING)` guard, so the cross package shipped
# without a file the native one installs. qemu-aarch64 is registered through
# binfmt here and hokuto exports QEMU_LD_PREFIX, so the target binary runs
# directly and the generated file is identical either way.
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    install -d "${1}${PREFIX}/share/icewm"
    ./build/genpref -o "${1}${PREFIX}/share/icewm/preferences" -s
fi

# po/CMakeLists mirrors the locale tree into a "playground" directory for
# development convenience, and its DESTINATION is CMAKE_CURRENT_BINARY_DIR,
# which is absolute. `cmake --install` with DESTDIR therefore recreates the
# whole build path inside the package, e.g.
#   $1/var/tmp/hokuto/icewm-01/build/build/po/playground/es/LC_MESSAGES/icewm.mo
#
# Upstream means to avoid this: it prefers file(CREATE_LINK) at configure time
# and only falls back to install() on CMake older than 3.14. The guard is
# written `if(CMAKE_VERSION VERSION_GREATER OR VERSION_EQUAL "3.14")`, which is
# malformed and evaluates false on current CMake, so the install() branch runs.
#
# The old cleanup removed "$1/build", which only matched when the build was an
# in-tree ./build. Remove the tree where it actually lands, then prune the empty
# parents that leaves behind (var/tmp/...) without touching anything else.
rm -rf "${1}${PWD}"
rmdir -p --ignore-fail-on-non-empty "$(dirname "${1}${PWD}")" 2>/dev/null || true

# The package must contain nothing outside the install prefix.
if find "$1" -mindepth 1 -maxdepth 1 ! -name usr ! -name etc ! -name var -print -quit | grep -q .; then
    echo "icewm: unexpected top-level directories in the package:" >&2
    find "$1" -mindepth 1 -maxdepth 1 ! -name usr ! -name etc ! -name var >&2
    exit 1
fi
