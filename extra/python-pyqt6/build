#!/bin/bash -e

# Qt 6.12 removed QEvent::EnterEditFocus and LeaveEditFocus, which PyQt6 6.11
# still binds (it builds with QT_KEYPAD_NAVIGATION). Drop them until a PyQt6
# release for Qt 6.12 does.
sed -i '/^ *EnterEditFocus,$/d; /^ *LeaveEditFocus,$/d' sip/QtCore/qcoreevent.sip

sip-build \
   --confirm-license \
   --qmake-setting 'CONFIG += c++17' \
   --no-make \
   --qmake=/usr/lib/qt6/bin/qmake6 \
   --api-dir /usr/share/qt6/qsci/api/python \
   --pep484-pyi

cd build
make
make INSTALL_ROOT="$1" install

#  compile Python bytecode
python -m compileall -d / "$1"/usr/lib
python -O -m compileall -d / "$1"/usr/lib
