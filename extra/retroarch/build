#!/bin/bash -e

patch -Np1 -i retroarch-config.patch
patch -Np1 -i ffmpeg-9.patch
# config.def.h has no __aarch64__ case for the Linux core-updater URL, so a
# 64-bit ARM build ships an empty buildbot address and the Core Updater can
# download nothing until the user types one in.
patch -Np1 -i buildbot-aarch64.patch

# The aarch64 buildbot is nightly-only and much of it is flagged experimental,
# which the Core Downloader hides unless this default is flipped.
patch -Np1 -i core-updater-experimental.patch

PREFIX="${CROSS_PREFIX:-/usr}"

# qb/config.libs.sh picks the global config dir with
#     case "$PREFIX" in /usr*) GLOBAL_CONFIG_DIR=/etc ;; *) ... esac
# and that /usr* glob also matches /usr/aarch64-linux-gnu, so a cross-system
# build would drop retroarch.cfg into the host's own /etc. Spell it out.
SYSCONF_DIR="${PREFIX}/etc"
[ "$PREFIX" = "/usr" ] && SYSCONF_DIR="/etc"

cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # X11 and KMS are both kept: RetroArch draws its own menu (XMB/Ozone/GLUI)
    # with GL either way, so it runs windowed under X or straight on the
    # console through DRM/KMS. Qt is only the optional desktop "companion"
    # window and is unrelated to the X11 build -- dropping it costs nothing
    # and avoids cross building Qt.
    #
    # Everything below is off because it is not cross built: wayland (no
    # compositor here, and libdecor is missing), vulkan (our mesa has no
    # vulkan driver for the V3D), sdl2, pulseaudio, v4l2 and glslang.
    # PipeWire is asked for explicitly -- RetroArch has a native driver, so
    # unlike Firefox it needs no PulseAudio shim.
    cross_opts=(
        --host="${HOKUTO_ARCH}-linux-gnu"
        --disable-qt
        --disable-wayland
        --disable-vulkan
        --disable-glslang
        --disable-pulse
        --enable-pipewire
        --disable-v4l2
    )
fi

 ./configure \
    --prefix="$PREFIX" \
    --enable-builtinmbedtls \
    --disable-builtinzlib \
    --disable-cg \
    --disable-jack \
    --disable-oss \
    --disable-sdl \
    --enable-dbus \
    --sysconfdir="$SYSCONF_DIR" \
    "${cross_opts[@]}"

# These two build the .so filter plugins, which run on the *target*. Their
# Makefiles hardcode `compiler := gcc` (only macOS takes it from $(CC)) while
# still folding $(CFLAGS) in, so a cross build feeds the target's flags to the
# host compiler:
#     cc1: error: bad value 'armv8-a+crc' for '-march=' switch
# A cross,system build hides it -- those flags are -mtune=generic, which the
# host gcc accepts, so it silently produced x86_64 plugins instead. Hand them
# the cross compiler; natively $CC is gcc, so this is a no-op there.
make -C libretro-common/audio/dsp_filters compiler="${CC:-gcc}"
make -C gfx/video_filters compiler="${CC:-gcc}"

make DESTDIR="${1}" install
install -Dm 644 libretro-common/audio/dsp_filters/*.{dsp,so} -t "${1}${PREFIX}"/lib/retroarch/filters/audio/
install -Dm 644 gfx/video_filters/*.{filt,so} -t "${1}${PREFIX}"/lib/retroarch/filters/video/

(
cd assets

install -dm 755 "${1}${PREFIX}"/share/retroarch/assets
cp -dr --no-preserve=ownership glui "${1}${PREFIX}"/share/retroarch/assets/
cp -dr --no-preserve=ownership xmb "${1}${PREFIX}"/share/retroarch/assets/
cp -dr --no-preserve=ownership ozone "${1}${PREFIX}"/share/retroarch/assets/
cp -dr --no-preserve=ownership fonts "${1}${PREFIX}"/share/retroarch/assets/
cp -dr --no-preserve=ownership sounds "${1}${PREFIX}"/share/retroarch/assets/
)

# The joypad profiles live in their own upstream repo, so without this nothing
# is ever autoconfigured and every pad comes up as
#     Microsoft X-Box 360 pad (1118/654) not configured
# retroarch.cfg points joypad_autoconfig_dir here (see retroarch-config.patch).
# These are plain text profiles -- no architecture, nothing to cross build.
(
cd autoconfig
make install PREFIX="$PREFIX" DESTDIR="$1"
)

# Core info files. Without these RetroArch has no idea which extensions a core
# accepts, so the content browser filters every directory down to nothing and a
# history entry offers no core to run it with -- the cores themselves download
# and load fine, they are just invisible. They are shipped read-only data like
# the assets and joypad profiles, so they live under /usr and libretro_info_path
# points there.
#
# Pinned to a master commit rather than the v1.22.2 tag: the aarch64 buildbot is
# nightly-only and the tag lags it badly -- 291 info files against the nightly
# set's 327, and its mednafen_psx entry is missing "bin" from
# supported_extensions.
(
cd info
make install PREFIX="$PREFIX" DESTDIR="$1"
)
