#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

MESON_OPTS=(
  --prefix="$PREFIX"
  -D systemd_logind=true
  -D seatd_libseat=false
  -D drm=true
  -D suid_wrapper=true
)

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    MESON_OPTS+=(--cross-file "${HOKUTO_ARCH}")
    # Xvfb, Xnest and Xephyr are test/nested servers that pull in the whole
    # client-side X and xcb stack. The target only needs the real server, so
    # they stay off until those libraries exist for aarch64.
    MESON_OPTS+=(-D xvfb=false -D xnest=false -D xephyr=false)
    # mesa now cross-builds, so GLX, glamor and DRI2/3 are on: glamor is what
    # makes the modesetting driver usable, and build_modesetting itself is
    # false without libgbm. DRI1 stays off -- it is ancient and unused.
    MESON_OPTS+=(-D glx=true -D glamor=true -D dri1=false -D dri2=true -D dri3=true)

    # fontrootdir otherwise comes from xorg-font-util's .pc in the sysroot, so
    # the target package ends up with a compiled-in font path of
    # /usr/aarch64-linux-gnu/share/fonts/X11. Every entry then fails to open at
    # startup, X runs with no fonts at all, and there is no cursor font to draw
    # the pointer with.
    MESON_OPTS+=(-D "fontrootdir=$PREFIX/share/fonts/X11")
else
    MESON_OPTS+=(-D xvfb=true -D xnest=true -D xephyr=true)
fi

meson setup build "${MESON_OPTS[@]}"

meson compile -C build
meson install -C build --destdir=$1
