#!/bin/bash -e

PREFIX="/usr"
CMAKE_OPTS=()
_tool_prefix=""

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # A cross build installs into the target sysroot, never the host's /usr.
    PREFIX="${CROSS_PREFIX:-/usr}"
    _tool_prefix="${HOKUTO_ARCH}-linux-gnu-"
    CMAKE_OPTS+=(
    )
fi

# CMAKE_INSTALL_LIBDIR must stay RELATIVE. CMake joins a relative value with
# CMAKE_INSTALL_PREFIX, but honours an absolute one verbatim -- so hardcoding
# /usr/lib here sent every library, .pc and cmake file to the host's /usr/lib
# during a cross-system build, shadowing the native libjpeg-turbo with aarch64
# objects while bin/, include/ and share/ correctly followed the prefix.
cmake -B build \
    -D CMAKE_INSTALL_PREFIX="$PREFIX" \
    -D CMAKE_INSTALL_LIBDIR=lib \
    -D CMAKE_SHARED_LIBS=True \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_AR="$(command -v ${_tool_prefix}gcc-ar)" \
    -D CMAKE_RANLIB="$(command -v ${_tool_prefix}gcc-ranlib)" \
    -D CMAKE_NM="$(command -v ${_tool_prefix}gcc-nm)" \
    -D WITH_JPEG8=ON \
    "${CMAKE_OPTS[@]}"

cmake --build   build
DESTDIR=$1 cmake --install build

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32 bit split package
rm -rf build
pkgdir=$HOKUTO_SPLIT_DIR/lib32-$3
cmake_options=(
    -B build
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_INSTALL_LIBDIR=lib32
    -D CMAKE_BUILD_TYPE=None
    -D ENABLE_STATIC=OFF
    -D WITH_JAVA=OFF
    -D WITH_JPEG8=ON
    -G Ninja
    -W no-dev
)
export CC="gcc -m32"
export CXX="g++ -m32"
export PKG_CONFIG="i686-pc-linux-gnu-pkg-config"
cmake "${cmake_options[@]}"
cmake --build build
DESTDIR="$pkgdir" cmake --install build
# remove everything that is provided by libjpeg-turbo
rm -r "$pkgdir"/usr/{include,share,bin}
fi
