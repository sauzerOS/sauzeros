#!/bin/bash -e

cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    cross_opts+=(
      -D vapi=false
      -D tests=false
      -D libglycin-gtk4=false
      -D introspection=false
    )
fi

# librsvg-2.0.pc requires gdk-pixbuf-2.0, and gdk-pixbuf-2.0.pc requires
# glycin-2: the library this builds, which a clean build environment does not
# have, so pkg-config rejected librsvg (and gtk4) altogether. A stand-in
# glycin-2.pc, never installed, breaks the cycle (as in harfbuzz).
pcstub=$PWD/pc-stub
install -d "$pcstub"
printf 'Name: glycin-2\nDescription: stand-in for the glycin being built\nVersion: %s\nCflags: -I/usr/include/glycin-2\n' "$2" \
    > "$pcstub/glycin-2.pc"

hokuto-meson build -D pkg_config_path="$pcstub" "${cross_opts[@]}"
meson compile -C build
meson install -C build --destdir=$1

# libglycin-gtk4 links GTK 4; in glycin it made every gdk-pixbuf user pull
# GTK 4 and its GStreamer media stack. Not built for cross targets.
_pick "$1" glycin-gtk4 \
    usr/lib/libglycin-gtk4-2.so* \
    usr/lib/pkgconfig/glycin-gtk4-2.pc \
    usr/include/glycin-gtk4-2 \
    usr/lib/girepository-1.0/GlyGtk4-2.typelib \
    usr/share/gir-1.0/GlyGtk4-2.gir \
    usr/share/vala/vapi/glycin-gtk4-2.*
