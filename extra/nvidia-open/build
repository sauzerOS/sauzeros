#!/bin/bash -e

# Built per kernel: hokuto sets HOKUTO_KERNEL_DIR / HOKUTO_KERNEL_RELEASE.
: "${HOKUTO_KERNEL_DIR:?kernel module package: build it with hokuto as <name>~<kernel>}"

unset LDFLAGS CFLAGS CXXFLAGS

# disable RT CHECK
#export IGNORE_PREEMPT_RT_PRESENCE=1
patch -p1 -d kernel-open -i ../gpl.patch

# Build and install kernel modules
export SYSSRC="$HOKUTO_KERNEL_DIR"
export SYSOUT="$HOKUTO_KERNEL_DIR"
KERNEL_VERSION=$HOKUTO_KERNEL_RELEASE

# Build modules against the target kernel
make modules -j$(nproc)

# Install to the target kernel's module directory
mkdir -p "$1/lib/modules/${KERNEL_VERSION}/kernel/drivers/video"
cp kernel-open/*.ko "$1/lib/modules/${KERNEL_VERSION}/kernel/drivers/video/"

install -d $1/etc/modprobe.d
cp nvidia.conf $1/etc/modprobe.d/

# compress modules
find "$1" -name '*.ko' -exec zstd --rm -19 {} +
