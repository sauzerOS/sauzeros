#!/bin/bash -e

# remove nag screen
patch -Np1 -i nag-screen1.patch
patch -Np1 -i system-sqlite.patch

# allow to run from /usr
sed -i 's/std::memcmp(EmuFolders::AppRoot.data(), "\/usr\/", 5) == 0/false/' src/core/core.cpp

# additional content
cp {cheats.zip,patches.zip} data/resources

# unbreak the build
sed -i '/#ifdef __linux__/,/#endif/d' src/core/system.cpp
mv DuckStationDependencies.cmake CMakeModules/
sed -i 's/Qt6::Gui Qt6::Widgets/Qt6::Gui Qt6::GuiPrivate Qt6::Widgets/' src/duckstation-qt/CMakeLists.txt
# always build qt_frontend (conditional breaks cmake script)
sed -i '79d;90d' CMakeModules/DuckStationDependencies.cmake

# only build required deps with custom script/version file
mkdir -pv scripts/deps/patches
chmod +x build-dependencies-linux.sh
cp {versions,build-dependencies-linux.sh} scripts/deps/
cp libpng-1.6.56-apng.patch scripts/deps/patches/
scripts/deps/build-dependencies-linux.sh deps
cd deps
mv lib/* lib64/
rmdir lib
ln -s lib64 lib
mkdir -pv ../dep/prebuilt/linux-x64
cp -r * ../dep/prebuilt/linux-x64/
cd ..

# build duckstation
cmake -B build-release                              \
  -D CMAKE_C_COMPILER=clang                         \
  -D CMAKE_CXX_COMPILER=clang++                     \
  -D CMAKE_EXE_LINKER_FLAGS_INIT="-fuse-ld=lld"     \
  -D CMAKE_MODULE_LINKER_FLAGS_INIT="-fuse-ld=lld"  \
  -D CMAKE_SHARED_LINKER_FLAGS_INIT="-fuse-ld=lld"  \
  -D CMAKE_BUILD_TYPE=Release                       \
  -D CMAKE_INTERPROCEDURAL_OPTIMIZATION=ON          \

cmake --build build-release

# install everything into /usr/lib/duckstation
install -m 755 -d "${1}/usr/lib"
cp -drv --no-preserve='ownership' build-release/bin "${1}/usr/lib/duckstation"
# install bundled libraries
find "deps/lib64/" -name '*.so*' -exec cp -dv --no-preserve='ownership' '{}' "${1}/usr/lib/duckstation/" \;

# patch rpath
patchelf --force-rpath --set-rpath "/usr/lib/duckstation" "${1}/usr/lib/duckstation/duckstation-qt"

# A wrapper rather than a symlink: since Qt 6.12, applicationDirPath() is the
# directory of the path the program was started through (AT_EXECFN), symlink
# included, and DuckStation looks for its translations next to the
# executable. Started through a /usr/bin symlink it searched
# /usr/bin/translations and warned on every start.
install -d $1/usr/bin
cat > $1/usr/bin/duckstation-qt <<'EOF'
#!/bin/sh
exec /usr/lib/duckstation/duckstation-qt "$@"
EOF
chmod 755 $1/usr/bin/duckstation-qt
install -Dvm644 "duckstation-qt.desktop" "${1}/usr/share/applications/duckstation-qt.desktop"
install -Dvm644 "${1}/usr/lib/duckstation/resources/images/duck.png" "${1}/usr/share/icons/hicolor/64x64/apps/duckstation-qt.png"

# use custom achievement unlock sound (steam)
xz -dc unlock.wav.xz > "${1}/usr/lib/duckstation/resources/sounds/achievements/unlock.wav"
chmod 644 "${1}/usr/lib/duckstation/resources/sounds/achievements/unlock.wav"
