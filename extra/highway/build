#!/bin/bash -e

# A cross build installs into the target sysroot, never the host's /usr.
# CMAKE_INSTALL_LIBDIR must stay relative so CMake joins it with the prefix;
# an absolute value is taken verbatim and escapes the sysroot.

cmake -B build \
      -D CMAKE_INSTALL_PREFIX="${CROSS_PREFIX:-/usr}" \
      -D CMAKE_INSTALL_LIBDIR=lib \
      -D CMAKE_BUILD_TYPE=Release  \
      -D BUILD_TESTING=OFF         \
      -D BUILD_SHARED_LIBS=ON

cmake --build build
DESTDIR=$1 cmake --install build

