#!/bin/bash -e

#gcc 15 fix
sed '/typedef enum/,/bool ;/d' -i \
  src/ALAC/alac_{en,de}coder.c

PREFIX="${CROSS_PREFIX:-/usr}"

cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # The only cross consumer is icewm's icesound, which plays WAV files for
    # window-manager event sounds. None of the external codecs are cross built
    # and none are needed for that -- WAV/AIFF/AU are handled by libsndfile
    # itself -- so drop FLAC/Ogg/Vorbis/Opus and the MPEG (lame/mpg123) path.
    cross_opts=(
        --host="${HOKUTO_ARCH}-linux-gnu"
        --disable-external-libs
        --disable-mpeg
    )
fi

./configure \
    --prefix="$PREFIX" \
    --disable-static \
    "${cross_opts[@]}"

make
make DESTDIR="$1" install

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32bit split package
make distclean
CC="gcc -m32" CXX="g++ -m32"         \
PKG_CONFIG_PATH=/usr/lib32/pkgconfig \
./configure --prefix=/usr            \
            --libdir=/usr/lib32      \
            --host=i686-pc-linux-gnu

make
make DESTDIR=$PWD/DESTDIR install
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -vr DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
