#!/bin/bash -e

hokuto-meson build \
  -D glamor=true   \
  -D dri3=true     \
  -D xkb_dir=/usr/share/X11/xkb \
  -D xkb_output_dir=/var/lib/xkb \

meson compile -C build
meson install -C build --destdir=$1

# xorg-server-common file /usr/lib/xorg/protocol.txt
rm "${1}"/usr/lib/xorg/protocol.txt
rmdir "${1}"/usr/lib/xorg
rm "${1}"/usr/share/man/man1/Xserver.1
