#!/bin/bash -e

export CFLAGS="${CFLAGS//-O2/}"
export CXXFLAGS="${CXXFLAGS//-O2/}"

# A cross-system build installs into the target sysroot rather than the host's
# /usr, and configure needs --host so it stops probing the build machine.
PREFIX="${CROSS_PREFIX:-/usr}"

CROSS_OPTS=""
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_OPTS="--host=${HOKUTO_ARCH}-linux-gnu"
fi

autoreconf -fvi
./configure \
  --enable-prof \
  --enable-autogen \
  --disable-static \
  --prefix="$PREFIX" \
  $CROSS_OPTS
make
make DESTDIR="${1}" install
