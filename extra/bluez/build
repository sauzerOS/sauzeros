#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"
SYSCONF_DIR="${PREFIX}/etc"
LOCALSTATE_DIR="${PREFIX}/var"
if [ "$PREFIX" = "/usr" ]; then
    SYSCONF_DIR="/etc"
    LOCALSTATE_DIR="/var"
fi

cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # obex is disabled below, which is what wanted libical -- the only
    # dependency here that is not cross built. mesh stays on: it needs json-c
    # (cross built) and ell, and bluez carries its own ell copy in the
    # tarball, so nothing external is required for it.
    cross_opts=(--host="${HOKUTO_ARCH}-linux-gnu")
fi

# Every one of these directories is otherwise derived from pkg-config
# (dbus-1 datadir, udev udevdir, systemd unitdirs) or from exec_prefix, so
# under either cross mode they follow PKG_CONFIG_LIBDIR into the sysroot and
# the plain cross build lands its unit files, udev rules and hid2hci helper in
# /usr/aarch64-linux-gnu/... on the target. Pin them all to $PREFIX.
# libexecdir=$PREFIX/lib also puts bluetoothd/bluetooth-meshd in
# $PREFIX/lib/bluetooth, which is where the bluez-mesh split expects them and
# what bluetooth.service's ExecStart is generated from (@PKGLIBEXECDIR@).
./configure --prefix="$PREFIX"            \
            --sysconfdir="$SYSCONF_DIR"   \
            --localstatedir="$LOCALSTATE_DIR" \
            --libexecdir="$PREFIX/lib"    \
            --with-udevdir="$PREFIX/lib/udev" \
            --with-systemdsystemunitdir="$PREFIX/lib/systemd/system" \
            --with-systemduserunitdir="$PREFIX/lib/systemd/user" \
            --with-dbusconfdir="$PREFIX/share" \
            --with-dbussystembusdir="$PREFIX/share/dbus-1/system-services" \
            --disable-manpages    \
            --disable-obex        \
            --enable-btpclient    \
            --enable-midi         \
            --enable-sixaxis      \
            --enable-mesh         \
            --enable-hid2hci      \
            --enable-experimental \
            --enable-datafiles    \
            --enable-library      \
            "${cross_opts[@]}"

make

# The cups backend dir has no configure option: configure hardcodes
# `pkg-config cups --variable=cups_serverbin`, which resolves to the sysroot.
# Makefile.tools spells it `cupsdir = $(CUPS_SERVERBIN)/backend`, so a command
# line override redirects it.
make DESTDIR=$1 CUPS_SERVERBIN="$PREFIX/lib/cups" install

# The _pick paths below are spelled usr/..., which holds for a native build
# and for a plain cross build of the target (both use prefix /usr). A
# cross-system build installs under the sysroot prefix instead and keeps
# everything in the one aarch64-bluez package, so it skips the splits.
if [ "$PREFIX" = "/usr" ]; then
    # bluez-utils
    _pick "$1" bluez-utils usr/bin/{advtest,avinfo,avtest,bcmfw,bdaddr,bluemoon,bluetoothctl,bluetooth-player,bneptest,btattach,btconfig,btgatt-client,btgatt-server,btinfo,btiotest,btmgmt,btmon,btpclient,btpclientctl,btproxy,btsnoop,check-selftest,cltest,create-image,eddystone,gatt-service,hcieventmask,hcisecfilter,hex2hcd,hid2hci,hwdb,ibeacon,isotest,l2ping,l2test,mpris-proxy,nokfw,oobtest,rctest,rtlfw,scotest,seq2bseq,test-runner}
    _pick "$1" bluez-utils usr/lib/systemd/user/mpris-proxy.service
    _pick "$1" bluez-utils usr/share/man/man1/bluetoothctl*.1
    _pick "$1" bluez-utils usr/share/man/man1/{bdaddr,btattach,btmgmt,btmon,isotest,l2ping,rctest}.1
    _pick "$1" bluez-utils usr/share/man/man5/org.bluez.{A,B,C,D,G,I,L,M,N,P,T}*.5
    _pick "$1" bluez-utils usr/share/man/man7/{hci,l2cap,mgmt,sco,iso}.7
    _pick "$1" bluez-utils usr/share/zsh/site-functions/_bluetoothctl

    # bluez-libs
    _pick "$1" bluez-libs usr/include/bluetooth/
    _pick "$1" bluez-libs usr/lib/libbluetooth.so*
    _pick "$1" bluez-libs usr/lib/pkgconfig/

    # bluez-cups
    _pick "$1" bluez-cups usr/lib/cups/backend/bluetooth

    # bluez-hid2hci
    _pick "$1" bluez-hid2hci usr/lib/udev/
    _pick "$1" bluez-hid2hci usr/share/man/man1/hid2hci.1

    # bluez-mesh
    _pick "$1" bluez-mesh etc/bluetooth/mesh-main.conf
    _pick "$1" bluez-mesh usr/bin/{mesh-cfgclient,mesh-cfgtest}
    _pick "$1" bluez-mesh usr/lib/bluetooth/bluetooth-meshd
    _pick "$1" bluez-mesh usr/lib/systemd/system/bluetooth-mesh.service
    _pick "$1" bluez-mesh usr/share/dbus-1/system-services/org.bluez.mesh.service
    _pick "$1" bluez-mesh usr/share/dbus-1/system.d/bluetooth-mesh.conf
    _pick "$1" bluez-mesh usr/share/man/man8/bluetooth-meshd.8
fi

# make sure there are no files left to install
rm "$1$PREFIX/lib/libbluetooth.la"

# bluetooth.service wants ConfigurationDirectoryMode=0555
chmod -v 555 "$1$SYSCONF_DIR/bluetooth"

# fix module loading errors
install -dm755 "${1}${PREFIX}"/lib/modprobe.d
install -Dm644 bluetooth.modprobe "${1}${PREFIX}"/lib/modprobe.d/bluetooth-usb.conf
# load module at system start required by some functions
# https://bugzilla.kernel.org/show_bug.cgi?id=196621
install -dm755 "$1$PREFIX"/lib/modules-load.d
echo "crypto_user" > "$1$PREFIX"/lib/modules-load.d/bluez.conf
