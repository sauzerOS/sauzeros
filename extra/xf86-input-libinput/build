#!/bin/bash -e

# A cross-system build installs into the target sysroot.
PREFIX="${CROSS_PREFIX:-/usr}"
CONF_ARGS=(--prefix="$PREFIX")

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # These default to values read out of xorg-server.pc. In a cross build that
    # .pc lives in the sysroot and its paths carry the sysroot prefix, so the
    # driver would install to /usr/aarch64-linux-gnu/... inside a package meant
    # for the target's own /usr. Pin them to where the target expects them.
    CONF_ARGS+=(
        --host="$HOKUTO_ARCH-linux-gnu"
        --with-xorg-module-dir="$PREFIX/lib/xorg/modules"
        --with-xorg-conf-dir="$PREFIX/share/X11/xorg.conf.d"
        --with-sdkdir="$PREFIX/include/xorg"
    )
fi

./configure "${CONF_ARGS[@]}"
make
make DESTDIR=$1 install
