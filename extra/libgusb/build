#!/bin/bash -e

# gobject-introspection scans the just-built library, and the sysroot's GLib
# has no .gir; the VAPI is generated from the .gir. The self tests run target
# binaries.
cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    cross_opts+=(-D introspection=false -D vapi=false -D tests=false -D umockdev=disabled)
fi

hokuto-meson build \
  -D docs=false "${cross_opts[@]}"

meson compile -C build
meson install -C build --destdir=$1
