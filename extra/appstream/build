#!/bin/bash -e

cd AppStream-$2

qt=true
cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # Qt is not cross built. gobject-introspection scans the just-built
    # library, and the sysroot's GLib has no .gir; the VAPI comes from the
    # .gir.
    qt=false
    cross_opts+=(-D gir=false -D vapi=false)
    # The sysroot's systemd.pc spells its directories with the sysroot prefix.
    export PKG_CONFIG_SYSTEMD_ROOT_PREFIX="${CROSS_PREFIX:-/usr}"
fi

# --libexecdir/--sbindir: meson's own defaults, which appstream has always
# installed with.
hokuto-meson build      \
    --buildtype=release \
    --libexecdir=libexec \
    --sbindir=sbin      \
    -D apidocs=false    \
    -D docs=false       \
    -D man=false        \
    -D qt=$qt           \
    -D bash-completion=false \
    -D stemming=false "${cross_opts[@]}"

meson compile -C build
meson install -C build --destdir=$1
