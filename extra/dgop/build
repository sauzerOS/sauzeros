#!/bin/bash -e

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    if [ "${HOKUTO_CROSS_SYSTEM:-0}" = "1" ]; then
        echo "dgop: cross-system builds are not supported; nothing links against a Go program" >&2
        exit 1
    fi

    case "$HOKUTO_ARCH" in
        aarch64) GOARCH=arm64 ;;
        x86_64)  GOARCH=amd64 ;;
        *)       GOARCH=$HOKUTO_ARCH ;;
    esac
    # cgo stays enabled so the cross build produces the same dynamically
    # linked PIE binary as the native one. cgo and the external link step use
    # the cross CC hokuto exports.
    export GOARCH CGO_ENABLED=1
fi

export CGO_CPPFLAGS="$CPPFLAGS"
export CGO_CFLAGS="$CFLAGS"
export CGO_CXXFLAGS="$CXXFLAGS"
export CGO_LDFLAGS="$LDFLAGS"
export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
go build ./cmd/dgop

install -Dm0755 -t "${1}/usr/bin/" "${3}"
