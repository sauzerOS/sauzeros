#!/bin/bash -e

sed -i 's/AV_OPT_TYPE_CHANNEL_LAYOUT/AV_OPT_TYPE_CHLAYOUT/' filters/f_lavfi.c

# A deliberately small mpv for the Pi: X11 and DRM/KMS output through the V3D
# (gl + egl + gbm), ALSA and pipewire for audio, libass subtitles. Everything
# below is switched off because it is not cross built -- vaapi/vdpau (no libva
# or libvdpau), vulkan (libplacebo here is built without it), javascript (no
# mujs), sdl2, jack, openal, pulse, sndio, libarchive, libbluray, cdda, dvdnav,
# dvbin, uchardet, rubberband, zimg, vapoursynth, libavdevice.
#
# lua IS enabled: the on-screen controller (the overlay bar at the bottom),
# the console and the stats overlay are all Lua scripts shipped in
# player/lua/. mpv only accepts LuaJIT or Lua 5.1/5.2 -- its meson explicitly
# requires generic lua.pc to be '>=5.1.0, <5.3.0' -- so the repo's lua 5.5
# cannot serve here and aarch64-luajit is what satisfies it.
cross_opts=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    cross_opts+=(
      -D gl=enabled       -D egl=enabled      -D egl-x11=enabled
      -D egl-drm=enabled  -D gbm=enabled      -D gl-x11=enabled
      -D alsa=enabled     -D pipewire=enabled
      -D vulkan=disabled  -D shaderc=disabled -D spirv-cross=disabled
      -D vaapi=disabled   -D vaapi-x11=disabled -D vaapi-drm=disabled
      -D vdpau=disabled   -D vdpau-gl-x11=disabled
      -D wayland=disabled -D dmabuf-wayland=disabled -D egl-wayland=disabled
      -D lua=enabled      -D javascript=disabled
      -D sdl2-audio=disabled -D sdl2-video=disabled
      -D sdl2-gamepad=disabled
      -D jack=disabled    -D openal=disabled  -D pulse=disabled
      -D sndio=disabled   -D oss-audio=disabled
      -D libarchive=disabled -D libbluray=disabled -D cdda=disabled
      -D dvdnav=disabled  -D dvbin=disabled   -D uchardet=disabled
      -D rubberband=disabled -D zimg=disabled -D vapoursynth=disabled
      -D libavdevice=disabled -D caca=disabled -D sixel=disabled
      -D manpage-build=disabled -D html-build=disabled
    )
fi

hokuto-meson build \
  -D x11=enabled   \
  -D drm=enabled "${cross_opts[@]}"

meson compile -C build
meson install -C build --destdir=$1

# Pi defaults (hardware decoding, OpenGL) -- see files/mpv.conf. Only the
# package built *for* the target gets them: a cross,system build stages into
# the host sysroot under /usr/aarch64-linux-gnu, where a global /etc file has
# no business being.
if [ "${HOKUTO_CROSS:-0}" = "1" ] && [ "${CROSS_PREFIX:-/usr}" = "/usr" ]; then
    install -v -D -m644 mpv.conf "$1/etc/mpv/mpv.conf"
fi
