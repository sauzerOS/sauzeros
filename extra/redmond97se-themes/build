#!/bin/bash -e

# Arch-independent data: the release ships prebuilt themes and icons, so the
# same files serve every architecture.
PREFIX="${CROSS_PREFIX:-/usr}"

mkdir themes-out
tar -xJf themes/themes-v*.tar.xz -C themes-out --no-same-owner

for theme in themes-out/themes/*/; do
    name=$(basename "$theme")

    gtkdir="$HOKUTO_SPLIT_DIR/redmond97se-gtk-theme$PREFIX/share/themes/$name"
    install -d "$gtkdir"
    cp -r "$theme"/{gtk-2.0,gtk-3.0,gtk-4.0} "$gtkdir"/
    install -m644 "$theme"/{index.theme,version} "$gtkdir"/

    for sub in xfwm4 wine; do
        dest="$HOKUTO_SPLIT_DIR/redmond97se-$sub-theme$PREFIX/share/themes/$name"
        install -d "$dest"
        cp -r "$theme/$sub" "$dest"/
    done
done

for split in redmond97se-gtk-theme redmond97se-xfwm4-theme redmond97se-wine-theme; do
    install -Dm644 "themes-out/themes/Redmond97 SE Classic/LICENSE" \
        "$HOKUTO_SPLIT_DIR/$split$PREFIX/share/licenses/$split/LICENSE"
done

icondir="$HOKUTO_SPLIT_DIR/obsidian-pure-icon-theme$PREFIX/share/icons"
install -d "$icondir"
tar -xJf icons/Obsidian_Pure_v*.tar.xz -C "$icondir" --no-same-owner

install -Dm644 README.md -t "$1$PREFIX/share/doc/$3"
