#!/bin/bash -e

if [ "${HOKUTO_GENERIC}" = "1" ]; then
    GCC_CPU="x86-64-v2"
    RUST_CPU="x86-64-v2"
else
    GCC_CPU="native"
    RUST_CPU="native"
fi

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    # Cross-compilation configuration
    PREFIX="${CROSS_PREFIX:-/usr}"

    # CMake's own cross settings come from the toolchain file hokuto generates.
    # Corrosion still needs the Rust triple named explicitly; it does not read
    # anything CMake knows about the target.
    RUST_TARGET="$HOKUTO_ARCH-unknown-linux-gnu"

    CMAKE_OPTS="-D Rust_CARGO_TARGET=$RUST_TARGET"
    # We rely on the build environment variables (CC, CXX, CFLAGS, LDFLAGS) set by Hokuto.
    # Do NOT unset CFLAGS/LDFLAGS here.
else
    # Native optimized build
    unset CFLAGS LDFLAGS

    WARNING_FLAGS="-Werror=odr -Werror=strict-aliasing"
    COMMON_FLAGS="-march=${GCC_CPU} -O2 -flto=thin -pipe ${WARNING_FLAGS}"
    CFLAGS="${COMMON_FLAGS}"
    CXXFLAGS="${COMMON_FLAGS}"
    FCFLAGS="${COMMON_FLAGS}"
    FFLAGS="${COMMON_FLAGS}"

    RUSTFLAGS="-C target-cpu=${RUST_CPU} -C strip=debuginfo -C opt-level=3 \
    -Clinker=clang -Clinker-plugin-lto -Clink-arg=-fuse-ld=lld"

    LDFLAGS="${COMMON_FLAGS} ${LDFLAGS} -fuse-ld=lld"
    CC="clang"
    CXX="clang++"
    CPP="clang-cpp"
    AR="llvm-ar"
    NM="llvm-nm"
    RANLIB="llvm-ranlib"
    PREFIX="/usr"
    export CC CXX CPP AR NM RANLIB CFLAGS CXXFLAGS LDFLAGS
fi

cmake -B build                     \
  -D CMAKE_INSTALL_PREFIX="$PREFIX" \
  -D CMAKE_INSTALL_SYSCONFDIR=/etc \
  -D CMAKE_BUILD_TYPE=Release      \
  -D WITH_DOCS=OFF                 \
  -D FISH_USE_SYSTEM_PCRE2=ON      \
  -D WITH_MESSAGE_LOCALIZATION=ON  \
  -W no-author \
  $CMAKE_OPTS

cmake --build build
DESTDIR=$1 cmake --install build

install -Dm644 config.fish $1/etc/fish/config.fish
