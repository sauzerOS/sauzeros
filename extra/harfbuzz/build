#!/bin/bash -e

# FreeType and GLib are what pango and other consumers link against
# (hb_ft_*, hb_glib_*). As "auto" features, meson silently drops them when the
# target sysroot lacks them, which produces a libharfbuzz that breaks pango at
# run time instead of a failed build.
hokuto-meson build \
    -D freetype=enabled \
    -D glib=enabled

meson compile -C build
meson install -C build --destdir=$1

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32bit split package
rm -rf build
hokuto-meson-32 build       \
      -D graphite2=disabled \
      -D tests=disabled

meson compile -C build
meson install -C build --destdir=$PWD/DESTDIR
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -vr DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
