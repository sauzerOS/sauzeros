#!/bin/bash -e

PREFIX="${CROSS_PREFIX:-/usr}"

CROSS_ARGS=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    CROSS_SYSROOT="$(${CC:-${HOKUTO_ARCH}-linux-gnu-gcc} -print-sysroot 2>/dev/null)"
    [ -n "$CROSS_SYSROOT" ] || CROSS_SYSROOT="/usr/${HOKUTO_ARCH}-linux-gnu"

    # rpm fills %_host / %_host_cpu in /usr/lib/rpm/macros from
    # CMAKE_HOST_SYSTEM_PROCESSOR, i.e. the *build* machine's CPU, so a cross
    # build would tell the target rpm it is running on x86_64. The two
    # variables hold the same value in a native build, so this rewrite only
    # changes anything when cross compiling.
    sed -i 's/CMAKE_HOST_SYSTEM_PROCESSOR/CMAKE_SYSTEM_PROCESSOR/' CMakeLists.txt

    CROSS_ARGS=(
        -D CMAKE_SYSTEM_NAME=Linux
        -D CMAKE_SYSTEM_PROCESSOR="$HOKUTO_ARCH"
        -D CMAKE_SYSROOT="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH="$CROSS_SYSROOT"
        -D CMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER
        -D CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY
        -D CMAKE_FIND_ROOT_PATH_MODE_PACKAGE=ONLY
    )

    if [ "${HOKUTO_CROSS_SYSTEM:-0}" = "1" ]; then
        # FindPython3 derives Python3_SITEARCH by running the interpreter, and
        # the only runnable interpreter here is the host's, which points at
        # /usr/lib/pythonX.Y/site-packages -- outside $PREFIX and on top of the
        # host's own rpm module. Nothing imports an aarch64 rpm module from the
        # sysroot anyway.
        CROSS_ARGS+=(-D ENABLE_PYTHON=OFF)
    else
        # Plain cross installs into /usr just like the native build, so the
        # host interpreter's site-packages path is the right one. Its headers
        # and libpython are not: pin those to the sysroot so the extension is
        # built against the target Python.
        PY_INC="$(ls -d "$CROSS_SYSROOT"/include/python3.* 2>/dev/null | sort -V | tail -n1)"
        PY_VER="$(basename "${PY_INC:-python3}")"
        CROSS_ARGS+=(
            -D Python3_INCLUDE_DIR="$PY_INC"
            -D Python3_LIBRARY="$CROSS_SYSROOT/lib/lib${PY_VER}.so"
        )
    fi
fi

cmake -B builddir                      \
    -D WITH_AUDIT=OFF                  \
    -D WITH_DBUS=OFF                   \
    -D ENABLE_TESTSUITE=OFF            \
    -D WITH_SELINUX=OFF                \
    -D WITH_SEQUOIA=OFF                \
    -D WITH_FAPOLICYD=OFF              \
    -D CMAKE_INSTALL_PREFIX="$PREFIX"   \
    -D CMAKE_BUILD_TYPE=Release        \
    "${CROSS_ARGS[@]}"

cmake --build builddir
DESTDIR=$1 cmake --install builddir
