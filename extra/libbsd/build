#!/bin/bash -e

autoreconf -vfi
CFLAGS+=' -ffat-lto-objects' \
./configure --prefix=/usr

make
make DESTDIR="${1}" install

# included now in man-pages, FS#53351
rm -f "${1}"/usr/share/man/man3/explicit_bzero.3

if [ "$MULTILIB" = "1" ]; then
#32bit split package
make distclean
CC="gcc -m32" CXX="g++ -m32" ./configure \
    --host=i686-pc-linux-gnu \
    --prefix=/usr            \
    --libdir=/usr/lib32      \
    --disable-static         \
    --with-gcc-arch=i686

make
make DESTDIR=$PWD/DESTDIR install
dest_dir="$HOKUTO_SPLIT_DIR/lib32-$3"
install -d $dest_dir/usr/lib32
cp -Rv DESTDIR/usr/lib32/* $dest_dir/usr/lib32
fi
