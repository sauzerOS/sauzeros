#!/bin/bash -e

# See gdk-pixbuf: the cross glib has no introspection, and libthai is not in
# the sysroot, so both must be off for the target rather than autodetected.
introspection_opt=enabled
libthai_opt=auto
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    introspection_opt=disabled
    libthai_opt=disabled
fi

hokuto-meson build \
  -D introspection=$introspection_opt \
  -D libthai=$libthai_opt

meson compile -C build
meson install -C build --destdir=$1

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32 bit split package
rm -rf build
pkgdir=$HOKUTO_SPLIT_DIR/lib32-$3
hokuto-meson-32 build \
  -D introspection=disabled \
  -D libthai=disabled

meson compile -C build
meson install -C build --destdir=$pkgdir
rm -r "$pkgdir"/usr/{bin,include}
fi
