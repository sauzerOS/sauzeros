#!/bin/bash -e

cd firefox-$2
patch -Np1 -i ../0001-Install-under-remoting-name.patch
mv ../google-api-key .

if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    mv ../mozconfig.cross ./mozconfig
    rm -f ../mozconfig

    # Everything is clang here, aimed at the target by --target/--sysroot
    # rather than by a gcc-prefixed toolchain, because Firefox's build system
    # assumes one compiler driver it can pass both host and target work to.
    # CROSS_PREFIX is /usr in a plain cross build (it describes the *target*
    # filesystem), so the build-machine path to the sysroot has to be spelled
    # out.
    SYSROOT="/usr/${HOKUTO_ARCH}-linux-gnu"
    TRIPLE="${HOKUTO_ARCH}-linux-gnu"

    # hokuto already exports CFLAGS/CXXFLAGS for the target; keep them and just
    # add the targeting. No -march=native, obviously.
    #
    # The recipe carries "nocrossopt" so those are the generic
    # -O2 -pipe -mtune=generic -fPIC rather than CFLAGS_ARM64's
    # -march=armv8-a+crc -mcpu=cortex-a72. Firefox does separate host from
    # target flags (rust.mk exports CFLAGS_<host-triple> and
    # CFLAGS_<target-triple> independently), but the target set still reaches
    # build-script crates that compile for the build machine -- glslopt does
    # exactly that -- and then:
    #   clang: error: unsupported option '-mcpu=' for target 'x86_64-unknown-linux-gnu'
    # -mtune=generic is valid for both architectures, which is what makes the
    # generic set work where the tuned one cannot.
    CC="clang --target=${TRIPLE} --sysroot=${SYSROOT}"
    CXX="clang++ --target=${TRIPLE} --sysroot=${SYSROOT}"
    CPP="clang-cpp --target=${TRIPLE} --sysroot=${SYSROOT}"
    LDFLAGS="${LDFLAGS} -fuse-ld=lld"

    # Tools that run on the build machine during the build.
    #
    # Deliberately NOT exporting HOST_CFLAGS/HOST_CXXFLAGS. config.mk reassigns
    # them:
    #     HOST_CFLAGS = $(COMPUTED_HOST_CFLAGS) $(_HOST_DEPEND_CFLAGS)
    # and exporting the names here keeps make's *new* value in the export set,
    # so cargo's environment ends up carrying make's per-target dependency
    # flags. cc-rs reads HOST_CFLAGS for any crate that compiles for the build
    # machine (glslopt does), runs in the crate's own directory where no .deps/
    # exists, and dies with:
    #     error: error opening '.deps/force-cargo-library-build.pp'
    # Left unexported, HOST_CFLAGS stays an ordinary make variable and never
    # reaches cargo. Firefox works out host flags by itself.
    export HOST_CC="clang"
    export HOST_CXX="clang++"

    # No -Clinker-plugin-lto: LTO is disabled for the cross build.
    RUSTFLAGS="-C strip=debuginfo -C opt-level=3 -C linker=clang \
-C link-arg=--target=${TRIPLE} -C link-arg=--sysroot=${SYSROOT} \
-C link-arg=-fuse-ld=lld"
else
    mv ../mozconfig .
    rm -f ../mozconfig.cross

    if [ "${HOKUTO_GENERIC}" = "1" ]; then
        GCC_CPU="x86-64-v2"
        RUST_CPU="x86-64-v2"
    else
        GCC_CPU="native"
        RUST_CPU="native"
    fi

    # LTO
    COMMON_FLAGS="-march=${GCC_CPU} -O2 -flto=thin -pipe ${WARNING_FLAGS}"
    CFLAGS="${COMMON_FLAGS}"
    CXXFLAGS="${COMMON_FLAGS}"
    FCFLAGS="${COMMON_FLAGS}"
    FFLAGS="${COMMON_FLAGS}"

    RUSTFLAGS="-C target-cpu=${RUST_CPU} -C strip=debuginfo -C opt-level=3 \
-Clinker=clang -Clinker-plugin-lto -Clink-arg=-fuse-ld=lld"

    LDFLAGS="${COMMON_FLAGS} ${LDFLAGS} -fuse-ld=lld -flto=thin"
    CC="clang"
    CXX="clang++"
    CPP="clang-cpp"
fi

AR="llvm-ar"
NM="llvm-nm"
RANLIB="llvm-ranlib"

export MOZILLA_OFFICIAL=1
export MOZ_NOSPAM=1
export RUST_MIN_STACK=16777216
ulimit -n 4096

export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none
export MOZBUILD_STATE_PATH=${PWD}/mozbuild

./mach build $MAKEFLAGS --priority normal

export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=none
DESTDIR=$1 ./mach install

# Desktop file & icon
install -d $1/usr/share/applications
install -d $1/usr/share/icons/hicolor/symbolic/apps
install -Dvm644 ../firefox.desktop $1/usr/share/applications/
install -Dvm644 ../firefox-symbolic.svg -t "$1/usr/share/icons/hicolor/symbolic/apps"

# Install desktop icons and metadata
theme=official
for i in 16 22 24 32 48 64 128 256; do
install -Dvm644 browser/branding/$theme/default$i.png \
"$1/usr/share/icons/hicolor/${i}x${i}/apps/firefox.png"
done
install -Dvm644 browser/branding/$theme/content/about-logo.png \
"$1/usr/share/icons/hicolor/192x192/apps/firefox.png"
install -Dvm644 browser/branding/$theme/content/about-logo@2x.png \
"$1/usr/share/icons/hicolor/384x384/apps/firefox.png"
install -Dvm644 browser/branding/$theme/content/about-logo.svg \
"$1/usr/share/icons/hicolor/scalable/apps/firefox.svg"

# distribution
install -Dvm644 ../distribution.ini "$1/usr/lib/$3/distribution/distribution.ini"
