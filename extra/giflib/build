#!/bin/bash -e

CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"

PREFIX="${CROSS_PREFIX:-/usr}"

# giflib ships a plain Makefile. CC and friends are passed on the command line
# so a makefile-level assignment cannot override the cross toolchain, the way
# an environment variable would be overridden.
_tools=()
if [ "${HOKUTO_CROSS:-0}" = "1" ]; then
    _tools=(CC="$CC" AR="$AR" RANLIB="$RANLIB")
fi

make "${_tools[@]}"
make "${_tools[@]}" DESTDIR=$1 PREFIX="$PREFIX" install

if [ "${HOKUTO_CROSS:-0}" != "1" ] && [ "$MULTILIB" = "1" ]; then
#32 bit split package
make clean
pkgdir=$HOKUTO_SPLIT_DIR/lib32-$3
make CC="gcc -m32"
make PREFIX=/usr LIBDIR=/usr/lib32 DESTDIR="${pkgdir}" install
rm -r "${pkgdir}"/usr/{include,share,bin}
fi
