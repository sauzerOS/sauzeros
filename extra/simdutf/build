#!/bin/bash -e

# A cross build installs into the target sysroot, never the host's /usr, and
# CMAKE_INSTALL_LIBDIR must stay relative so it joins with the prefix.
cmake -B build                                  \
  -D CMAKE_INSTALL_PREFIX="${CROSS_PREFIX:-/usr}" \
  -D CMAKE_INSTALL_LIBDIR=lib                   \
  -D CMAKE_BUILD_TYPE=Release                   \
  -D BUILD_SHARED_LIBS=ON

cmake --build build
DESTDIR=$1 cmake --install build
